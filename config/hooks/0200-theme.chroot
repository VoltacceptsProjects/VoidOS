#!/bin/sh
set -e

echo "=== VoidOS: applying VoidGlass theme ==="

# Make our theme the system default GTK theme + window manager theme + icons
mkdir -p /etc/gtk-3.0
cat > /etc/gtk-3.0/settings.ini << 'GTK'
[Settings]
gtk-theme-name=VoidGlass-gtk
gtk-icon-theme-name=Papirus-Dark
gtk-font-name=Inter 10
gtk-cursor-theme-name=Adwaita
gtk-application-prefer-dark-theme=1
gtk-button-images=1
gtk-menu-images=1
GTK

mkdir -p /etc/skel/.config/gtk-3.0
cp /etc/gtk-3.0/settings.ini /etc/skel/.config/gtk-3.0/settings.ini

# Register picom to autostart for every user.
# NOTE: VoidUI is a macOS-style layout: a thin top menu bar (VoidOS menu +
# status items, see xfce4-panel.xml) plus VoidDock, a real from-scratch
# GTK/Cairo floating dock (config/includes.chroot/usr/local/bin/voiddock.py)
# that owns all app launching/magnification/running-app indicators. The top
# panel deliberately has no launcher/tasklist plugins of its own -- that's
# VoidDock's job, same division of labor as macOS's menu bar vs. Dock.
mkdir -p /etc/xdg/autostart
# picom needs a real Exec (no %u expansion in .desktop autostart); use env instead
cat > /etc/xdg/autostart/voidos-picom.desktop << 'DESK'
[Desktop Entry]
Type=Application
Name=VoidOS Compositor
Exec=sh -c "picom --config \\$HOME/.config/picom.conf"
X-GNOME-Autostart-enabled=true
NoDisplay=true
DESK

# VoidDock: the floating magnifying dock. Delay it slightly past picom so
# the dock's ARGB window is already composited (real blur/transparency)
# the first time it's shown instead of flashing opaque for one frame.
cat > /etc/xdg/autostart/voidos-voiddock.desktop << 'DESK'
[Desktop Entry]
Type=Application
Name=VoidDock
Exec=sh -c "sleep 1; voiddock.py"
X-GNOME-Autostart-enabled=true
NoDisplay=true
DESK

# Show a one-time notification pointing new users at the Persistent Drive
# setup tool, so "no install needed" persistence is actually discoverable.
cat > /etc/xdg/autostart/voidos-persistence-nudge.desktop << 'DESK'
[Desktop Entry]
Type=Application
Name=VoidOS Persistence Nudge
Exec=voidos-persistence-nudge
X-GNOME-Autostart-enabled=true
NoDisplay=true
DESK

# Set wallpaper + panel/dock defaults for new users via xfce4 xml (already placed by includes.chroot)
# Set plymouth boot theme
if [ -d /usr/share/plymouth/themes/voidos ]; then
    plymouth-set-default-theme -R voidos || true
fi

# Set lightdm greeter theme to match
mkdir -p /etc/lightdm/lightdm-gtk-greeter.conf.d
cat > /etc/lightdm/lightdm-gtk-greeter.conf.d/50-voidos.conf << 'GRT'
[greeter]
theme-name = VoidGlass-gtk
icon-theme-name = Papirus-Dark
font-name = Inter 10
background = /usr/share/backgrounds/voidos/wallpaper.svg
default-user-image = #avatar-default
indicators = ~host;~spacer;~clock;~spacer;~session;~language;~power
GRT

# Make sure these scripts are executable regardless of how includes.chroot's
# permission bits survived getting here (e.g. a GitHub web upload of the
# repo strips +x, same caveat as auto/config -- see README).
chmod +x /usr/local/bin/voidos-persistence-setup 2>/dev/null || true
chmod +x /usr/local/bin/voidos-persistence-nudge 2>/dev/null || true
chmod +x /usr/local/bin/voiddock.py 2>/dev/null || true
chmod +x /usr/local/bin/voidos-appmenu.py 2>/dev/null || true

echo "=== VoidOS: theme applied ==="
