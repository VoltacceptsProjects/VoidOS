#!/bin/sh
set -e

echo "=== VoidOS: installing rsvg compatibility shim ==="

# Ubuntu's "live-build" package is a very old snapshot (3.0~a57, 2012). Its
# binary_syslinux script re-enters this chroot later on to install
# librsvg2-bin/mtools/syslinux and then shells out to the legacy `rsvg`
# command to render config/bootloaders/isolinux/splash.svg.in into
# splash.png and the LSS16 bootlogo syslinux boots with. Modern
# librsvg2-bin (2.x, the version that gets installed here since we target
# bookworm) only ships `rsvg-convert` -- the plain `rsvg` CLI was dropped
# from the package years ago -- so without this shim the stage fails with
# "/usr/bin/env: 'rsvg': No such file or directory" and no ISO is produced.
#
# This has to be installed *inside* the chroot (not on the GitHub runner)
# because that's where live-build actually runs the syslinux stage.
# rsvg-convert itself isn't installed yet at this point in the build --
# it gets pulled in later, right before this shim is actually invoked --
# so we only drop the wrapper script now; it resolves `rsvg-convert` at
# run time via exec, once it exists.
cat > /usr/bin/rsvg << 'EOF'
#!/bin/bash
# Compatibility shim: old `rsvg` CLI -> modern `rsvg-convert`.
args=()
positional=()
have_o=0
while [ $# -gt 0 ]; do
  case "$1" in
    -o|--output)
      have_o=1
      args+=("$1" "$2")
      shift 2
      ;;
    -w|--width|-h|--height|-x|--x-zoom|-y|--y-zoom|-d|--dpi-x|-p|--dpi-y|-f|--format|-b|--background-color|-i|--export-id)
      # these legacy flags all take a following value; keep flag+value together
      args+=("$1" "$2")
      shift 2
      ;;
    -*)
      args+=("$1")
      shift
      ;;
    *)
      positional+=("$1")
      shift
      ;;
  esac
done
if [ "$have_o" -eq 0 ] && [ "${#positional[@]}" -eq 2 ]; then
  exec rsvg-convert "${args[@]}" -o "${positional[1]}" "${positional[0]}"
else
  exec rsvg-convert "${args[@]}" "${positional[@]}"
fi
EOF
chmod +x /usr/bin/rsvg

echo "=== VoidOS: rsvg compatibility shim installed ==="
