#!/bin/bash
# VoidOS Persistent Drive setup
#
# Creates a loopback filesystem image file -- a "VoidOS Persistent Drive"
# (.vospd) -- that live-boot will automatically detect and use to persist
# "/" across reboots, even though VoidOS was never installed to a disk.
#
# How this plugs into live-boot: live-boot's default
# persistence-storage=file,filesystem setting already makes it probe every
# readable filesystem's *root directory* at boot for an image file (or
# partition) whose name matches persistence-label. VoidOS's boot parameters
# (see live.cfg.in) set persistence-label=VoidOS.vospd, so any filesystem
# -- an internal drive, a second USB stick, whatever -- that has a
# VoidOS.vospd file sitting at its top level, containing a persistence.conf
# that says "/ union", becomes VoidOS's persistent storage on the next boot.
# No installer, no dedicated partition required.
#
# This script only needs udisks2 (loop-setup/mount, unprivileged for the
# desktop user at the console via the default polkit rules) and e2fsprogs
# (mkfs.ext4, which can format a plain file directly -- no root needed).

set -u
IMAGE_NAME="VoidOS.vospd"
APP_TITLE="VoidOS Persistent Drive"

fail() {
    zenity --error --title="$APP_TITLE" --width=420 --text="$1"
    exit 1
}

command -v zenity >/dev/null || { echo "zenity is required" >&2; exit 1; }
for bin in udisksctl mkfs.ext4 truncate findmnt lsblk; do
    command -v "$bin" >/dev/null || fail "Missing required tool: $bin"
done

zenity --question --title="$APP_TITLE" --width=480 --text="\
<b>Set up a VoidOS Persistent Drive</b>

This creates a <tt>${IMAGE_NAME}</tt> file on a drive of your choice.
VoidOS will automatically find and use it on every future boot to keep
your files, settings, and installed apps -- no installation required.

You'll pick a drive, then choose a size. The file must live at the very
top level of that drive (not inside a folder) so VoidOS can find it.

Continue?" || exit 0

# --- Pick a target drive/folder -------------------------------------------
TARGET_DIR=$(zenity --file-selection --directory \
    --title="Choose the drive for your VoidOS Persistent Drive" \
    --filename="/media/${USER:-void}/") || exit 0

# The image must sit at the root of its filesystem, or live-boot won't find
# it at boot -- confirm the chosen folder IS a mountpoint, not a subfolder.
MOUNT_ROOT=$(findmnt -T "$TARGET_DIR" -no TARGET 2>/dev/null)
if [ -z "$MOUNT_ROOT" ] || [ "$MOUNT_ROOT" != "$TARGET_DIR" ]; then
    fail "\
'$TARGET_DIR' isn't the top level of a drive.

Please pick the drive's root folder itself (e.g. the folder that
appears right under /media/$USER/<drive name>), not a folder inside it."
fi

if [ ! -w "$TARGET_DIR" ]; then
    fail "'$TARGET_DIR' isn't writable. Pick a drive you have write access to."
fi

IMAGE_PATH="${TARGET_DIR%/}/${IMAGE_NAME}"
if [ -e "$IMAGE_PATH" ]; then
    zenity --question --title="$APP_TITLE" --width=420 --text="\
A ${IMAGE_NAME} already exists on this drive.

Replace it? (This erases anything currently saved in it.)" || exit 0
    rm -f "$IMAGE_PATH"
fi

# --- Free space + filesystem-type-aware size suggestion --------------------
AVAIL_KB=$(df --output=avail -k "$TARGET_DIR" | tail -1)
AVAIL_GB=$(( AVAIL_KB / 1024 / 1024 ))
FSTYPE=$(findmnt -T "$TARGET_DIR" -no FSTYPE 2>/dev/null)

FAT_WARNING=""
if [ "$FSTYPE" = "vfat" ]; then
    FAT_WARNING="\n\n<b>Note:</b> this drive is FAT32, which caps any single file at 4&#160;GiB. Pick a size under 4."
fi

SIZE_GB=$(zenity --entry --title="$APP_TITLE" --width=420 \
    --text="How large should the Persistent Drive be, in GB?\n(About ${AVAIL_GB} GB free on this drive.)${FAT_WARNING}" \
    --entry-text="8") || exit 0

case "$SIZE_GB" in
    ''|*[!0-9]*) fail "Enter a whole number of GB." ;;
esac
[ "$SIZE_GB" -ge 1 ] || fail "Size must be at least 1 GB."
if [ "$FSTYPE" = "vfat" ] && [ "$SIZE_GB" -ge 4 ]; then
    fail "FAT32 can't hold a single file that large. Choose 3 GB or less, or pick a drive formatted as exFAT/NTFS/ext4."
fi
if [ "$SIZE_GB" -gt "$AVAIL_GB" ]; then
    fail "Only about ${AVAIL_GB} GB free on this drive."
fi

# --- Build the image, format it, drop in persistence.conf ------------------
(
    echo "10"; echo "# Reserving ${SIZE_GB} GB..."
    truncate -s "${SIZE_GB}G" "$IMAGE_PATH" || exit 1

    echo "35"; echo "# Formatting as ext4..."
    mkfs.ext4 -q -F -L voidospersist "$IMAGE_PATH" || exit 1

    echo "55"; echo "# Mounting the new drive..."
    LOOP_OUT=$(udisksctl loop-setup -f "$IMAGE_PATH" --no-user-interaction 2>&1) || exit 1
    LOOP_DEV=$(echo "$LOOP_OUT" | sed -n 's/.*[Mm]apped file .* as \(\/dev\/loop[0-9]*\).*/\1/p')
    [ -n "$LOOP_DEV" ] || exit 1

    udisksctl mount -b "$LOOP_DEV" --no-user-interaction >/dev/null 2>&1 || exit 1
    LOOP_MNT=$(lsblk -no MOUNTPOINT "$LOOP_DEV" | head -1)
    [ -n "$LOOP_MNT" ] || exit 1

    echo "80"; echo "# Writing persistence.conf..."
    echo "/ union" > "$LOOP_MNT/persistence.conf" || exit 1
    sync

    echo "95"; echo "# Finishing up..."
    udisksctl unmount -b "$LOOP_DEV" --no-user-interaction >/dev/null 2>&1
    udisksctl loop-delete -b "$LOOP_DEV" --no-user-interaction >/dev/null 2>&1
    echo "100"
) | zenity --progress --title="$APP_TITLE" --width=420 \
    --text="Setting up your Persistent Drive..." --auto-close --no-cancel

if [ $? -ne 0 ] || [ ! -e "$IMAGE_PATH" ]; then
    rm -f "$IMAGE_PATH" 2>/dev/null
    fail "Something went wrong creating the Persistent Drive. No changes were kept."
fi

zenity --info --title="$APP_TITLE" --width=440 --text="\
<b>Your VoidOS Persistent Drive is ready.</b>

${IMAGE_PATH}

Reboot with this drive connected and VoidOS will automatically use it
to save your files, settings, and apps -- every time, with no extra
boot options to pick."
