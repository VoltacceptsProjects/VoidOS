#!/bin/bash
# Shows a one-time desktop notification pointing new users at the
# Persistent Drive setup tool. Harmless if it's already been dismissed,
# already persistent, or notify-send is briefly unavailable at login.
MARKER="$HOME/.config/.voidos-persistence-nudge-shown"
[ -e "$MARKER" ] && exit 0
mkdir -p "$(dirname "$MARKER")"
touch "$MARKER"

sleep 8

command -v notify-send >/dev/null || exit 0
notify-send \
    --icon=drive-harddisk \
    "Want VoidOS to remember your files?" \
    "Set up a VoidOS Persistent Drive from the Start menu -- no install needed. Search for 'Persistent Drive'."
