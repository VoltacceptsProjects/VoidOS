# VoidOS - VoidUI window manager (xfwm4) theme, "VoidUI" redesign
# macOS-vibrancy-style borders (thin translucent frame, frosted glass read
# through from picom/GTK) laid out Windows-11-style: no window icon, plain
# left-aligned title, minimize/maximize/close on the right, subtler corner
# rounding than the old build. Ember/gold accent for the active title bar.

active_text_color=#fbeee6
inactive_text_color=#d8b8ac
active_shadow_color=#000000
inactive_shadow_color=#000000

font=Inter Bold 9

show_app_icon=false
title_alignment=left
title_shadow_active=false
title_shadow_inactive=false

button_layout=|HMC
button_spacing=2

corner_radius=10

# Frame thickness (kept thin so the "glass" panel border reads through)
frame_border_top=30
frame_border_bottom=4
frame_border_left=4
frame_border_right=4

repeat_button_pixmap=false
maximized_offset=0

# Colors are mostly driven via picom transparency + GTK theme;
# xfwm4 pixmap-based theming is intentionally kept minimal here so
# the compositor's blur/translucency does the visual work.
