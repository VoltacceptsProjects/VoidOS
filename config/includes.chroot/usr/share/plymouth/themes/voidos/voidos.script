// VoidOS plymouth boot splash: dark void background + ember pulsing ring + logo image
// (VoidUI redesign: warm dark tones + ember accent, matching the sunset wallpaper)

Window.SetBackgroundTopColor(0.08, 0.05, 0.05);
Window.SetBackgroundBottomColor(0.02, 0.01, 0.01);

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);

// simple pulsing ring made of dots to avoid needing bundled art assets
ring_dots = 24;
ring_radius = logo.image.GetWidth() / 2 + 30;
for (i = 0; i < ring_dots; i++) {
  dot[i].image = Image.Text("•", 1, 0.42, 0.24, 1, "Sans 20");
  dot[i].sprite = Sprite(dot[i].image);
}

fun refresh_callback() {
  progress = Math.Int(Plymouth.GetBootProgress() * 100);
  angle_step = 360 / ring_dots;
  t = Window.GetProgress ? Window.GetProgress() : 0;

  for (i = 0; i < ring_dots; i++) {
    angle = (i * angle_step + (Plymouth.GetTimeElapsed() * 60)) * 3.14159 / 180;
    x = Window.GetWidth()  / 2 + ring_radius * Math.Cos(angle) - 6;
    y = Window.GetHeight() / 2 - 40 + ring_radius * Math.Sin(angle) - 6;
    dot[i].sprite.SetX(x);
    dot[i].sprite.SetY(y);
    opacity = 0.35 + 0.65 * ((i % ring_dots) / ring_dots);
    dot[i].sprite.SetOpacity(opacity);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun quit_callback() {
  logo.sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
