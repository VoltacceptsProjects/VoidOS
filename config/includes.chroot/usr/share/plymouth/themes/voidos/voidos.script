// VoidOS plymouth boot splash: dark void background + violet pulsing ring + logo text

Window.SetBackgroundTopColor(0.04, 0.04, 0.08);
Window.SetBackgroundBottomColor(0.01, 0.01, 0.03);

logo.image = Image.Text("VoidOS", 1, 1, 1, 1, "Sans Bold 42");
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 40);

// simple pulsing ring made of dots to avoid needing bundled art assets
ring_dots = 24;
ring_radius = 46;
for (i = 0; i < ring_dots; i++) {
  dot[i].image = Image.Text("•", 0.55, 0.36, 0.95, 1, "Sans 20");
  dot[i].sprite = Sprite(dot[i].image);
}

fun refresh_callback() {
  progress = Math.Int(Plymouth.GetBootProgress() * 100);
  angle_step = 360 / ring_dots;
  t = Window.GetProgress ? Window.GetProgress() : 0;

  for (i = 0; i < ring_dots; i++) {
    angle = (i * angle_step + (Plymouth.GetTimeElapsed() * 60)) * 3.14159 / 180;
    x = Window.GetWidth()  / 2 + ring_radius * Math.Cos(angle) - 6;
    y = Window.GetHeight() / 2 + 40 + ring_radius * Math.Sin(angle) - 6;
    dot[i].sprite.SetX(x);
    dot[i].sprite.SetY(y);
    opacity = 0.35 + 0.65 * ((i % ring_dots) / ring_dots);
    dot[i].sprite.SetOpacity(opacity);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

fun quit_callback() {
  logo.sprite.SetOpacity(0);
}
Plymouth.SetQuitFunction(quit_callback);
