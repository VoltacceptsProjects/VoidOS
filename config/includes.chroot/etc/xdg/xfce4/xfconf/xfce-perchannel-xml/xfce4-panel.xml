<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="panels" type="array">
    <value type="int" value="1"/>
    <property name="panel-1" type="empty">
      <!-- VoidOS menu bar: thin, full-width, top of screen, the macOS
           menu-bar slot. App launching lives entirely in VoidDock (the
           floating bottom dock, a separate custom-coded app started
           alongside picom); this bar is system status + the VoidOS menu,
           same division of labor as macOS's menu bar vs. Dock.
           p=6 is Xfce's "north / top edge" screen position. -->
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="uint" value="100"/>
      <property name="length-adjust" type="bool" value="true"/>
      <property name="position-locked" type="bool" value="true"/>
      <property name="size" type="uint" value="28"/>
      <property name="icon-size" type="uint" value="16"/>
      <property name="background-alpha" type="uint" value="55"/>
      <property name="background-style" type="uint" value="1"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <!-- VoidOS menu: the Apple-menu equivalent (About, Settings, Force
         Quit, Lock, Restart, Shut Down, Log Out), see voidos-appmenu.py.
         Not an app launcher; VoidDock's Launchpad icon covers that. -->
    <property name="plugin-1" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="/usr/share/applications/voidos-appmenu.desktop"/>
      </property>
      <property name="show-label" type="bool" value="false"/>
    </property>

    <!-- Left expander: pushes everything else to the right edge -->
    <property name="plugin-2" type="string" value="separator">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>

    <!-- Search: Spotlight equivalent, opens xfce4-appfinder -->
    <property name="plugin-3" type="string" value="launcher">
      <property name="items" type="array">
        <value type="string" value="/usr/share/applications/voidos-search.desktop"/>
      </property>
      <property name="show-label" type="bool" value="false"/>
    </property>

    <property name="plugin-4" type="string" value="pulseaudio"/>
    <property name="plugin-5" type="string" value="power-manager-plugin"/>
    <property name="plugin-6" type="string" value="systray"/>

    <property name="plugin-7" type="string" value="separator">
      <property name="expand" type="bool" value="false"/>
      <property name="style" type="uint" value="0"/>
    </property>

    <property name="plugin-8" type="string" value="clock">
      <property name="digital-format" type="string" value="%a %d %b  %H:%M"/>
    </property>
  </property>
</channel>
