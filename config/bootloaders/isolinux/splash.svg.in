<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<svg xmlns="http://www.w3.org/2000/svg"
     width="640" height="480" viewBox="0 0 640 480" version="1.1">
  <defs>
    <!-- Sky: intense red at top → deep purple at horizon -->
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="480" gradientUnits="userSpaceOnUse">
      <stop offset="0"    stop-color="#A00113"/>
      <stop offset="0.18" stop-color="#D42C23"/>
      <stop offset="0.40" stop-color="#9A1840"/>
      <stop offset="0.62" stop-color="#4A1048"/>
      <stop offset="1"    stop-color="#1E0A28"/>
    </linearGradient>

    <!-- Warm radial bloom around the ring -->
    <radialGradient id="bloom" cx="320" cy="165" r="180" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#FFB860" stop-opacity="0.45"/>
      <stop offset="0.35" stop-color="#FF7040" stop-opacity="0.18"/>
      <stop offset="0.7"  stop-color="#C02030" stop-opacity="0.06"/>
      <stop offset="1"   stop-color="#800020" stop-opacity="0"/>
    </radialGradient>

    <!-- Soft vignette for the void disk -->
    <radialGradient id="voidShade" cx="320" cy="165" r="68" gradientUnits="userSpaceOnUse">
      <stop offset="0"   stop-color="#0A0410"/>
      <stop offset="0.7" stop-color="#12061C"/>
      <stop offset="1"   stop-color="#1A0A24"/>
    </radialGradient>
  </defs>

  <!-- Background sky -->
  <rect width="640" height="480" fill="url(#sky)"/>
  <rect width="640" height="480" fill="url(#bloom)"/>

  <!-- ========== Mountain layers (back → front) ========== -->
  <!-- Distant range -->
  <path fill="#2A0A30" d="
    M0,310
    C45,295 85,300 130,285
    C180,265 225,290 280,270
    C335,250 385,275 440,260
    C490,245 535,270 580,255
    C610,245 635,255 640,250
    L640,480 L0,480 Z"/>

  <!-- Far-mid range -->
  <path fill="#3C1040" d="
    M0,335
    C50,320 95,330 150,310
    C205,290 255,320 315,300
    C375,280 420,310 480,295
    C530,280 575,305 620,290
    C635,285 640,290 640,290
    L640,480 L0,480 Z"/>

  <!-- Mid range (richer) -->
  <path fill="#5C1838" d="
    M0,360
    C55,345 100,355 155,335
    C215,315 265,345 330,325
    C390,305 440,335 505,320
    C555,305 600,330 640,320
    L640,480 L0,480 Z"/>

  <!-- Near-mid -->
  <path fill="#7A1C32" d="
    M0,385
    C50,370 100,380 155,365
    C215,345 270,375 340,355
    C405,335 460,365 525,350
    C575,335 615,360 640,350
    L640,480 L0,480 Z"/>

  <!-- Near range -->
  <path fill="#4A1020" d="
    M0,415
    C55,400 110,410 170,395
    C235,375 295,405 365,385
    C430,365 490,395 555,380
    C600,370 630,390 640,385
    L640,480 L0,480 Z"/>

  <!-- Foreground hills -->
  <path fill="#2C0818" d="
    M0,445
    C70,430 140,440 215,425
    C290,410 360,435 435,420
    C505,405 570,430 625,420
    C635,418 640,422 640,420
    L640,480 L0,480 Z"/>

  <!-- ========== Glowing ring + void ========== -->
  <g>
    <!-- Soft outer atmospheric glow -->
    <circle cx="320" cy="165" r="100" fill="none"
            stroke="#FFAA40" stroke-width="36" opacity="0.10"/>
    <circle cx="320" cy="165" r="94" fill="none"
            stroke="#FFCC60" stroke-width="24" opacity="0.16"/>
    <circle cx="320" cy="165" r="88" fill="none"
            stroke="#FFE070" stroke-width="14" opacity="0.28"/>

    <!-- Primary bright ring (cream → gold) -->
    <circle cx="320" cy="165" r="79" fill="none"
            stroke="#FBE1A4" stroke-width="14"/>
    <circle cx="320" cy="165" r="77" fill="none"
            stroke="#F0C850" stroke-width="8"/>
    <circle cx="320" cy="165" r="73" fill="none"
            stroke="#FFF0B0" stroke-width="3.5" opacity="0.85"/>

    <!-- Thin darker inner rim for depth -->
    <circle cx="320" cy="165" r="69" fill="none"
            stroke="#E09030" stroke-width="2" opacity="0.6"/>

    <!-- The void itself -->
    <circle cx="320" cy="165" r="67.5" fill="url(#voidShade)"/>
  </g>

  <!-- ========== VoidOS wordmark ========== -->
  <!-- Soft glow underlay -->
  <text x="320" y="315" text-anchor="middle"
        font-family="DejaVu Sans, Arial, Helvetica, sans-serif"
        font-size="48" font-weight="600" letter-spacing="1.5"
        fill="#FFCC66" opacity="0.35">VoidOS</text>
  <!-- Main text -->
  <text x="320" y="315" text-anchor="middle"
        font-family="DejaVu Sans, Arial, Helvetica, sans-serif"
        font-size="48" font-weight="600" letter-spacing="1.5"
        fill="#FBE1A4">VoidOS</text>
  <!-- Subtle highlight edge -->
  <text x="320" y="315" text-anchor="middle"
        font-family="DejaVu Sans, Arial, Helvetica, sans-serif"
        font-size="48" font-weight="600" letter-spacing="1.5"
        fill="none" stroke="#FFE8B0" stroke-width="0.8" opacity="0.5">VoidOS</text>

</svg>