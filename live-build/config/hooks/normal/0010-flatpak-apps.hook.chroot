#!/bin/sh
# ------------------------------------------------------------------
# Steam and Modrinth aren't in the Debian repos in a form that fits
# a minimal live-build chroot cleanly (native Steam needs i386
# multiarch + downloads its runtime on first launch anyway, and the
# Modrinth App isn't packaged for Debian at all). Since flatpak is
# already a required package, both are installed as system flatpaks
# here so they're baked into the ISO and ready at first boot.
# ------------------------------------------------------------------
set -e

echo "I: Adding Flathub remote"
flatpak remote-add --if-not-exists flathub https://flathub.org/repo/flathub.flatpakrepo

echo "I: Installing Steam (com.valvesoftware.Steam)"
flatpak install -y --system flathub com.valvesoftware.Steam

echo "I: Installing Modrinth App (com.modrinth.ModrinthApp)"
flatpak install -y --system flathub com.modrinth.ModrinthApp
